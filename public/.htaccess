# Xserver (Apache) .htaccess for security, caching, redirects

<IfModule mod_headers.c>
  # Security headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"

  # CSP (start with Report-Only; switch to Enforce after verification)
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; frame-src https://www.google.com; connect-src 'self'; frame-ancestors 'self'"
  # To enforce, comment out the line above and uncomment the line below
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; frame-src https://www.google.com; connect-src 'self'; frame-ancestors 'self'"

  # CORS for web fonts (allow cross-origin usage)
  <FilesMatch "\.(eot|ttf|otf|woff|woff2)$">
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Redirects
Redirect 301 /contact https://line.me/R/ti/p/@792kbrnd
Redirect 301 /contact/ https://line.me/R/ti/p/@792kbrnd

# Caching
<IfModule mod_headers.c>
  # No cache for HTML
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Long cache for common static assets
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|gif|mp4|css|js|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Immutable cache for Astro hashed assets under /_astro/
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^_astro/ - [E=ASTRO:1]
</IfModule>

# Compression (gzip/deflate; Brotli if available)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  BrotliCompressionQuality 5
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>


